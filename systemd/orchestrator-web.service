[Unit]
Description=Orchestrator Web console (FastAPI + SSE)
After=llama-orchestrator.service litellm-proxy.service
Wants=litellm-proxy.service llama-orchestrator.service

[Service]
Type=simple
# Every file the service writes (chats.db, users.db, trace.db, rag.db and their
# -wal/-shm sidecars, plus uploads/outputs/projects/deliverables and
# session.secret) is created private to the service account. The DBs hold
# password hashes, TOTP secrets, and full conversation/tool content, so they
# must not be readable by other local users.
UMask=0077
# Path + secrets live in the env file (ORCH_CONFIG, PYTHONPATH, PATH, tokens).
# It is the single source of truth for the install path — edit it, not this unit.
# Required (no leading '-'): the service will not start until it exists at
#   ~/.config/orchestrator.env   (see systemd/orchestrator.env for a template).
EnvironmentFile=%h/.config/orchestrator.env
# NOTE: ExecStart's binary path can't read env vars, so the venv path is literal
# here; if you install outside /srv/orchestrator, update WorkingDirectory +
# ExecStart below AND the path lines in orchestrator.env.
# Reachable from the LAN (reverse proxy lives on another host). Because it is no
# longer localhost-only, set a token below and/or firewall the port to the proxy.
# Environment=ORCH_WEB_TOKEN=change-me
WorkingDirectory=/srv/orchestrator
ExecStart=/srv/orchestrator/.venv/bin/uvicorn web.server:app \
    --host 0.0.0.0 --port 8071 \
    --proxy-headers --forwarded-allow-ips=PROXY_IP_HERE
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
