# JayNet Orchestrator — service environment
# ---------------------------------------------------------------------------
# Deploy to:  ~/.config/orchestrator.env   (the user units read it via
#             EnvironmentFile=%h/.config/orchestrator.env)
# Permissions: chmod 600  — it holds tokens/keys.
#
#   install -Dm600 systemd/orchestrator.env ~/.config/orchestrator.env
#
# This is a plain systemd EnvironmentFile: KEY=VALUE only, NO shell expansion,
# NO ${VAR} interpolation, NO quotes needed. If you install the tree somewhere
# other than /srv/orchestrator, change ALL of the path lines below to match.
# ---------------------------------------------------------------------------

# --- Install path (the "present path" of the deployed tree) -----------------
# ORCH_HOME is a convenience anchor; ORCH_CONFIG and PYTHONPATH are the two the
# app/runtime actually read. Keep all three pointing at the same install dir.
ORCH_HOME=/srv/orchestrator
ORCH_CONFIG=/srv/orchestrator/config/runtime.yaml
PYTHONPATH=/srv/orchestrator

# --- PATH for tools that shell out ------------------------------------------
# A systemd --user service does NOT inherit your login PATH, so spell it out.
# This must reach: the venv (uvicorn/python), system bins (git), the sandbox
# (firejail for code.run), code-intel (ctags), formatters/linters (ruff, mypy),
# the venv tool (uv/pip for code.deps), and ROCm (rocm-smi for gpu.status).
PATH=/srv/orchestrator/.venv/bin:/usr/local/bin:/usr/bin:/bin:/opt/rocm/bin

# --- Auth / sessions --------------------------------------------------------
# First boot seeds an admin from these (or logs a generated password once).
# ORCH_ADMIN_USER=admin
# ORCH_ADMIN_PASSWORD=change-me-then-remove
# Persist sessions across restarts (else a secret is written to data/session.secret):
# ORCH_SESSION_SECRET=<long-random-string>
# Bearer token for API / native / CLI clients (set this if the port is reachable
# beyond localhost — the web unit binds 0.0.0.0):
# ORCH_WEB_TOKEN=<long-random-token>

# --- Brain / model plumbing -------------------------------------------------
# TWO separate consumers of the brain preset — same file, different jobs, both
# optional (each has a built-in default):
#   PRESET            read by scripts/start-llama.sh (the launch service) to pick
#                     which .conf to load and SERVE — this is what starts the brain.
#   ORCH_BRAIN_PRESET read by the orchestrator APP, only to learn the served model
#                     name + whether vision (an MMPROJ) is loaded. Launches nothing.
# Point both at the same file so launcher and app agree on what the brain is.
# PRESET=/srv/llama/presets/<your-brain>.conf
# ORCH_BRAIN_PRESET=/srv/llama/presets/<your-brain>.conf
# Needed only if serve.* registers LiteLLM aliases at runtime:
# LITELLM_MASTER_KEY=<key>

# --- Coder model (code.delegate target; served by llama-coder.service) ------
# Its OWN preset var — do NOT reuse the brain's PRESET. start-coder.sh pins this
# to GPU 1 (port 8080) and serves it with the tool-calling template so the
# delegated sub-agent can make tool calls. Then map a LiteLLM alias -> :8080,
# add a $0 costs: row for that alias, and set tools.code.delegate.model to it.
# CODER_PRESET=/srv/llama/presets/Qwopus3.6-27B-Coder-MTP-Q5_K_M.conf
# CODER_MODEL_PATH=/srv/models/.../Qwopus3.6-27B-Coder-MTP-Q5_K_M.gguf
# CODER_PORT=8080
# CODER_GPU=1
# CODER_TOOLS_TEMPLATE=/srv/orchestrator/config/qwen3.6-tools.jinja  # 'none' = model's own

# --- Provider API keys (used by tools; optional) ----------------------------
# TAVILY_API_KEY=<key>           # web.search preferred backend
# MOONSHOT_API_KEY=<key>         # llm.call -> kimi (K3, preferred cloud)
# GEMINI_API_KEY=<key>           # llm.call -> gemini
# ZAI_API_KEY=<key>              # llm.call -> glm
# DASHSCOPE_API_KEY=<key>        # llm.call -> qwen
