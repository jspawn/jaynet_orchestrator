[Unit]
Description=RAG embedding server (Qwen3-Embedding-8B Q8_0, CPU-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# CPU-only by design: -ngl 0 keeps every layer on the CPU, so the ~8 GB of
# weights live in system RAM and never touch VRAM — both R9700s stay free for
# the brain (GPU0) and on-the-fly models (GPU1). Hiding the ROCm devices is
# belt-and-suspenders so the HIP backend can't grab a GPU context; -ngl 0 is the
# real guarantee, so if a build ever misbehaves with an empty value you can drop
# these two lines without changing the CPU behaviour.
Environment=HIP_VISIBLE_DEVICES=
Environment=ROCR_VISIBLE_DEVICES=
ExecStart=/srv/llama/llama.cpp-rocm/build/bin/llama-server \
    --model /srv/models/Qwen3-Embedding-8B.Q8_0.gguf \
    --embeddings \
    --pooling last \
    --n-gpu-layers 0 \
    --threads 16 \
    --ctx-size 8192 \
    --host 127.0.0.1 \
    --port 8095
Restart=on-failure
RestartSec=10
# Avoid the llama-server SIGTERM-shutdown abort (static-dtor GC-thread join ->
# SIGABRT + core dump); a CPU-only embedding server has nothing to flush.
KillSignal=SIGKILL

[Install]
WantedBy=default.target
