[Unit]
Description=LiteLLM proxy (unified OpenAI API for local + cloud LLMs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/jaynet.env
# Cheap hardening (audit D15): the proxy needs no privileges, no shared /tmp
# and no write access to system dirs (its config is rendered into JAYNET_DATA).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
WorkingDirectory=/srv/orchestrator
# The proxy config is GENERATED from the preset DB (admin → Presets → Cloud
# models / preset catalog) into ${JAYNET_DATA}/litellm.yaml — outside the repo,
# so the live checkout stays pristine. ExecStartPre regenerates it on every
# boot (falls back to copying the repo's config/litellm.yaml seed, so the
# proxy always starts). Requires JAYNET_DATA in jaynet.env.
ExecStartPre=/srv/orchestrator/litellmenv/bin/python /srv/orchestrator/runtime/cloud_store.py render
ExecStart=/srv/orchestrator/litellmenv/bin/litellm \
    --config ${JAYNET_DATA}/litellm.yaml \
    --host 127.0.0.1 \
    --port ${JAYNET_LITELLM_PORT} \
    --num_workers 1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
