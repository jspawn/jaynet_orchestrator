[Unit]
Description=llama.cpp brain server (orchestrator, GPU0)
After=network-online.target
Wants=network-online.target

# NOTE: normally DISABLED — the web service's process manager boots the models
# itself (see `processes:` in config/runtime.yaml). Enable this unit only for a
# headless boot without orchestrator-web, and never alongside it (port fight).

[Service]
Type=simple
EnvironmentFile=%h/.config/orchestrator.env
ExecStart=/srv/orchestrator/scripts/start-model.sh brain
Restart=on-failure
RestartSec=10
# llama-server's SIGTERM/SIGINT handler calls exit(), which runs static
# destructors at teardown; the stream_session_manager destructor joins its GC
# thread there and std::terminate fires -> SIGABRT + core dump on every stop
# (upstream llama.cpp bug). Stopping with SIGKILL skips that path entirely. A
# stateless inference server has nothing to flush, so a hard kill is clean, and
# this only affects how the unit is STOPPED/restarted — a genuine runtime abort
# still exits 134 and surfaces as a failure.
KillSignal=SIGKILL
# Vulkan needs DRI access; user must be in `video` and `render` groups.
# No additional ambient capabilities required.

[Install]
WantedBy=default.target
