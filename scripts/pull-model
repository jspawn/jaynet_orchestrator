#!/usr/bin/env python3
"""Pull a GGUF model file from HuggingFace into the models dir.

Usage:
    pull-model bartowski/Qwen2.5-7B-Instruct-GGUF                      # pick from a menu
    pull-model bartowski/Qwen2.5-7B-Instruct-GGUF Qwen2.5-7B-Instruct-Q6_K.gguf
    pull-model bartowski/Qwen2.5-7B-Instruct-GGUF --yes                # list only, exit 2

Downloads into paths.MODELS_DIR/<repo>/<file> and prints MODEL_PATH=<abs path>
as the last stdout line (quickstart.sh parses it). The actual work lives in
runtime/hf_pull.py, shared with the admin GUI downloader.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# Ensure the install root is on sys.path when running this script directly.
# Defaults to the checkout this script lives in; override with JAYNET_HOME.
ORCH_ROOT = Path(os.environ.get("JAYNET_HOME") or os.environ.get(
    "ORCH_HOME", str(Path(__file__).resolve().parent.parent)))
if str(ORCH_ROOT) not in sys.path:
    sys.path.insert(0, str(ORCH_ROOT))

from runtime import hf_pull, paths  # noqa: E402


def _fmt_size(size: int | None) -> str:
    return f"{size / 1e9:6.2f} GB" if size else "     ?    "


def main(argv: list[str] | None = None) -> None:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("repo", help="HuggingFace repo, e.g. bartowski/Qwen2.5-7B-Instruct-GGUF")
    ap.add_argument("file", nargs="?", help="exact .gguf filename (default: interactive menu)")
    ap.add_argument("--yes", action="store_true",
                    help="non-interactive: with no file, list candidates and exit 2")
    args = ap.parse_args(argv)

    try:
        files = hf_pull.list_gguf(args.repo)
    except hf_pull.HfError as e:
        sys.exit(f"error: {e}")
    if not files:
        sys.exit(f"error: no .gguf files in {args.repo}")

    names = [n for n, _ in files]
    if args.file:
        if args.file not in names:
            print(f"error: '{args.file}' not in {len(names)} .gguf file(s):",
                  file=sys.stderr)
            for n in names:
                print(f"  {n}", file=sys.stderr)
            sys.exit(1)
        filename = args.file
    elif args.yes:
        for i, (n, size) in enumerate(files, 1):
            print(f"{i:3d}. {_fmt_size(size)}  {n}")
        sys.exit(2)
    else:
        for i, (n, size) in enumerate(files, 1):
            print(f"{i:3d}. {_fmt_size(size)}  {n}")
        try:
            pick = int(input("file number: ").strip())
            filename = files[pick - 1][0]
        except (ValueError, IndexError, EOFError):
            sys.exit("error: invalid selection")

    def _progress(done, total):
        if total:
            print(f"\r{done / total:6.1%}  {done / 1e9:.2f}/{total / 1e9:.2f} GB",
                  end="", flush=True)

    try:
        dest = hf_pull.stream_download(args.repo, filename,
                                       hf_pull.target_path(args.repo, filename),
                                       progress=_progress)
    except hf_pull.HfError as e:
        sys.exit(f"error: {e}")
    print()

    # Metadata; MODEL_PATH must stay the LAST stdout line (quickstart.sh greps it).
    print(f"repo:  {args.repo}")
    print(f"file:  {filename}")
    print(f"size:  {dest.stat().st_size / 1e9:.2f} GB")
    print(f"MODEL_PATH={dest}")
    print("next: add the model via Admin → Presets, or write a preset .conf "
          f"(see {paths.PRESETS_DIR} for examples) with MODEL_PATH={dest}",
          file=sys.stderr)


if __name__ == "__main__":
    main()
