#!/usr/bin/env python3
"""Command-line driver for the orchestrator.

Usage:
    orch "What's the weather in Zurich and is it warmer than London?"
    orch --max-cost 0.10 "Cheap quick question"
    orch --share-private "Summarize my notes, cloud models allowed"
    orch --trace 1a2b3c "Show me the trace of this run"
    orch --doctor  # validate the install (env file, paths, ports, services)
"""

from __future__ import annotations

import asyncio
import json
import os
import sys
from pathlib import Path

# Re-exec into the checkout's venv when started with a bare system python —
# click/rich and the runtime deps live there. Guarded so it happens once.
_VENV_PY = Path(__file__).resolve().parent.parent / ".venv" / "bin" / "python"
if _VENV_PY.is_file() and not os.environ.get("JAYNET_CLI_REEXEC"):
    try:
        import click as _probe_click  # noqa: F401
        import rich as _probe_rich  # noqa: F401
    except ImportError:
        os.environ["JAYNET_CLI_REEXEC"] = "1"
        os.execv(str(_VENV_PY),
                 [str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])

import click
from rich.console import Console
from rich.panel import Panel
from rich.syntax import Syntax

# The checkout root on sys.path so runtime.* imports resolve when running
# this script directly.
_CHECKOUT = Path(__file__).resolve().parent.parent
if str(_CHECKOUT) not in sys.path:
    sys.path.insert(0, str(_CHECKOUT))

from runtime.env import load_env_file  # noqa: E402

# The systemd units get their env via EnvironmentFile; load the same file so
# the CLI sees the same JAYNET_HOME / JAYNET_DATA / ports. Real env wins.
load_env_file()

# Ensure the install root is on sys.path when running this script directly.
# Defaults to the checkout this script lives in; override with JAYNET_HOME.
ORCH_ROOT = Path(os.environ.get("JAYNET_HOME") or os.environ.get(
    "ORCH_HOME", str(_CHECKOUT)))
if str(ORCH_ROOT) not in sys.path:
    sys.path.insert(0, str(ORCH_ROOT))

from runtime.loop import AgentRuntime  # noqa: E402

console = Console()


@click.command()
@click.argument("message", required=False)
@click.option("--max-iterations", type=int, help="Override iteration ceiling.")
@click.option("--max-wall-clock", type=float, help="Override wall-clock ceiling (seconds).")
@click.option("--max-cost", type=float, help="Override cost ceiling (USD).")
@click.option("--share-private", is_flag=True,
              help="Allow private tool results to be passed to remote LLMs.")
@click.option("--tools", "tools_csv",
              help="Comma-separated tool/namespace allowlist, e.g. 'web,code.execute'. "
                   "Overrides config tool_selection for this run.")
@click.option("--json-output", "json_out", is_flag=True,
              help="Output the full result dict as JSON instead of pretty-printing.")
@click.option("--trace", "trace_run_id", help="Show the trace of a previous run by id.")
@click.option("--list-tools", "list_tools", is_flag=True,
              help="List the tools the orchestrator discovers, then exit. "
                   "Works without the servers running.")
@click.option("--details", "details", is_flag=True,
              help="After the run, show a per-tool usage breakdown (call counts, "
                   "errors, latency) read from the run's trace.")
@click.option("--doctor", is_flag=True,
              help="Validate the install (env file, paths, ports, services), then exit.")
def cli(message, max_iterations, max_wall_clock, max_cost, share_private,
        tools_csv, json_out, trace_run_id, list_tools, details, doctor):
    if doctor:
        return _doctor()
    if list_tools:
        return _list_tools()
    if trace_run_id:
        return _show_trace(trace_run_id)

    if not message:
        console.print("[red]Error:[/red] need a message (or --trace <run_id>)")
        sys.exit(2)

    overrides = {}
    if max_iterations is not None:
        overrides["max_iterations"] = max_iterations
    if max_wall_clock is not None:
        overrides["max_wall_clock_s"] = max_wall_clock
    if max_cost is not None:
        overrides["max_cost_usd"] = max_cost

    runtime = AgentRuntime()
    tools = [t.strip() for t in tools_csv.split(",")] if tools_csv else None
    tools = [t for t in tools if t] if tools else None
    result = asyncio.run(runtime.run(
        message,
        share_private=share_private,
        budget_overrides=overrides or None,
        tools=tools,
    ))

    if json_out:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return

    status_color = {"ok": "green", "budget_exceeded": "yellow", "error": "red"}.get(
        result["status"], "white",
    )
    console.print(Panel(result["answer"] or "(empty)",
                        title=f"[{status_color}]{result['status']}[/{status_color}]"
                              f" — run {result['run_id'][:8]}",
                        border_style=status_color))
    b = result["budget"]
    console.print(
        f"[dim]iterations: {b['iterations']}  "
        f"elapsed: {b['elapsed_s']}s  "
        f"cost: ${b['cost_usd']:.4f}  "
        f"tokens: {b['tokens']['total']} "
        f"(cached: {b['tokens']['cached']})[/dim]"
    )

    # Tool-usage summary, read from this run's trace (no runtime changes needed).
    tallies = _tool_tallies(result["run_id"])
    if tallies:
        # Compact one-liner in the footer: "tools: web.search x2, llm.call, code.execute(1 err)"
        parts = []
        for name, t in sorted(tallies.items()):
            label = name
            if t["calls"] > 1:
                label += f" x{t['calls']}"
            if t["errors"]:
                label += f" ({t['errors']} err)"
            parts.append(label)
        console.print(f"[dim]tools: {', '.join(parts)}[/dim]")

        if details:
            from rich.table import Table
            tbl = Table(show_header=True, header_style="bold", box=None, pad_edge=False)
            tbl.add_column("tool"); tbl.add_column("calls", justify="right")
            tbl.add_column("ok", justify="right"); tbl.add_column("err", justify="right")
            tbl.add_column("avg ms", justify="right")
            for name, t in sorted(tallies.items()):
                avg = int(t["latency_ms"] / t["calls"]) if t["calls"] else 0
                tbl.add_row(name, str(t["calls"]), str(t["ok"]),
                            str(t["errors"]) if t["errors"] else "-", str(avg))
            console.print(tbl)

    if result.get("error"):
        console.print(f"[red]error: {result['error']}[/red]")


def _trace_db_path() -> str:
    """Trace DB location from the runtime config (falls back to the default)."""
    from runtime import paths
    try:
        from runtime.config_loader import load_config
        cfg = load_config(paths.CONFIG)   # resolves a relative trace.db_path
        p = (cfg.get("trace") or {}).get("db_path")
        if p:
            return p
    except Exception:
        pass
    return str(paths.TRACE_DB)


def _tool_tallies(run_id: str) -> dict:
    """Tally tool_result events for a run from trace.db. Pure read; orch-only.

    Returns {tool_name: {calls, ok, errors, latency_ms}}. Empty dict if the
    trace is unavailable or no tools were called.
    """
    import sqlite3
    tallies: dict = {}
    try:
        db = sqlite3.connect(_trace_db_path())
        db.row_factory = sqlite3.Row
        rows = db.execute(
            "SELECT payload_json FROM events WHERE run_id = ? AND kind = 'tool_result'",
            (run_id,),
        ).fetchall()
        db.close()
    except Exception:
        return {}
    for r in rows:
        try:
            p = json.loads(r["payload_json"]) if r["payload_json"] else {}
        except (json.JSONDecodeError, TypeError):
            continue
        name = p.get("tool") or "(unknown)"
        t = tallies.setdefault(name, {"calls": 0, "ok": 0, "errors": 0, "latency_ms": 0})
        t["calls"] += 1
        if p.get("status") == "ok":
            t["ok"] += 1
        else:
            t["errors"] += 1
        t["latency_ms"] += p.get("latency_ms") or 0
    return tallies


def _list_tools() -> None:
    """Build the tool registry and print what's discovered. No servers needed."""
    import yaml
    from runtime import paths
    from runtime.registry import ToolRegistry

    cfg_path = paths.CONFIG
    cfg = yaml.safe_load(cfg_path.open())
    tools_root = cfg_path.parent.parent / "tools"

    reg = ToolRegistry(tools_root)
    reg.discover()

    # Mark private namespaces the same way the runtime does, so the listing
    # reflects the real privacy flags.
    private_ns = set(cfg.get("privacy", {}).get("private_tool_namespaces", []))
    for t in reg.all():
        if t.name.split(".", 1)[0] in private_ns:
            t.private = True

    tools = sorted(reg.all(), key=lambda t: t.name)
    if not tools:
        console.print(f"[yellow]No tools discovered under {tools_root}[/yellow]")
        return

    console.print(f"[bold]Discovered {len(tools)} tool(s)[/bold] "
                  f"[dim]({tools_root})[/dim]\n")
    for t in tools:
        flags = []
        if t.private:
            flags.append("[red]private[/red]")
        if getattr(t, "requires_confirmation", False):
            flags.append("[yellow]confirm[/yellow]")
        flag_str = ("  " + " ".join(flags)) if flags else ""
        console.print(f"  [cyan]{t.name}[/cyan]{flag_str}")
        console.print(f"    [dim]{t.description}[/dim]")
        # For llm.call, surface the model enum so you can see which models are wired.
        props = t.parameters.get("properties", {})
        if "model" in props and "enum" in props["model"]:
            models = ", ".join(props["model"]["enum"])
            console.print(f"    [dim]models: {models}[/dim]")
    console.print()


def _show_trace(run_id: str) -> None:
    import sqlite3
    db = sqlite3.connect(_trace_db_path())
    db.row_factory = sqlite3.Row

    # Allow prefix match for convenience
    runs = db.execute(
        "SELECT * FROM runs WHERE id LIKE ? ORDER BY started_at DESC LIMIT 1",
        (run_id + "%",),
    ).fetchall()
    if not runs:
        console.print(f"[red]no run matching {run_id}[/red]")
        sys.exit(1)
    run = runs[0]
    console.print(Panel(
        f"id: {run['id']}\nstatus: {run['status']}\n"
        f"user: {run['user_message']}\n\nanswer: {run['final_answer']}",
        title="Run",
    ))

    events = db.execute(
        "SELECT * FROM events WHERE run_id = ? ORDER BY ts",
        (run["id"],),
    ).fetchall()
    for ev in events:
        payload = json.loads(ev["payload_json"]) if ev["payload_json"] else {}
        console.print(f"[dim]{ev['iteration']}.[/dim] [cyan]{ev['kind']}[/cyan]")
        console.print(Syntax(json.dumps(payload, indent=2, ensure_ascii=False)[:2000],
                             "json", theme="ansi_dark", word_wrap=True))


def _doctor() -> None:
    """Install health checks. Prints OK/WARN/FAIL per check; exit 1 on any FAIL."""
    import shutil
    import socket
    import subprocess
    from runtime import paths

    fails = warns = 0

    def report(status: str, label: str, hint: str = "") -> None:
        nonlocal fails, warns
        if status == "FAIL":
            fails += 1
        elif status == "WARN":
            warns += 1
        color = {"OK": "green", "WARN": "yellow", "FAIL": "red"}.get(status, "dim")
        line = f"[{color}]{status:<4}[/{color}] {label}"
        if hint:
            line += f"  [dim]→ {hint}[/dim]"
        console.print(line)

    # 1. interpreter + uv
    v = sys.version_info
    if v >= (3, 11):
        report("OK", f"python {v.major}.{v.minor}.{v.micro}")
    else:
        report("FAIL", f"python {v.major}.{v.minor} < 3.11", "use a newer interpreter")
    if shutil.which("uv"):
        report("OK", "uv on PATH")
    else:
        report("WARN", "uv not on PATH",
               "curl -LsSf https://astral.sh/uv/install.sh | sh")

    # 2. env file
    env_file = Path.home() / ".config" / "jaynet.env"
    if not env_file.exists():
        env_file = Path.home() / ".config" / "orchestrator.env"  # legacy name
    if not env_file.exists():
        report("FAIL", f"env file missing: {env_file}",
               "install -Dm600 example_configs/jaynet.env.example "
               "~/.config/jaynet.env")
    else:
        report("OK", f"env file: {env_file}")
        mode = env_file.stat().st_mode & 0o777
        if mode != 0o600:
            report("WARN", f"env file mode {mode:o} (want 600)", f"chmod 600 {env_file}")
        todo = []
        for line in env_file.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, val = line.split("=", 1)
            if "<" in val and ">" in val:          # untouched <...> placeholder
                todo.append(key.strip())
        if todo:
            report("WARN", f"env placeholders left: {', '.join(todo)}",
                   f"edit {env_file}")

    # 3. install + data paths
    if paths.HOME.exists():
        report("OK", f"JAYNET_HOME: {paths.HOME}")
    else:
        report("FAIL", f"JAYNET_HOME missing: {paths.HOME}",
               "set JAYNET_HOME in ~/.config/jaynet.env")
    if paths.CONFIG.exists():
        report("OK", f"config: {paths.CONFIG}")
    else:
        report("FAIL", f"config missing: {paths.CONFIG}")
    if paths.DATA.exists() and os.access(paths.DATA, os.W_OK):
        report("OK", f"JAYNET_DATA writable: {paths.DATA}")
    else:
        report("FAIL", f"JAYNET_DATA missing or not writable: {paths.DATA}",
               f"sudo mkdir -p {paths.DATA} && sudo chown $USER {paths.DATA}")

    # 4. ports — informational only
    for name, default in (("JAYNET_LITELLM_PORT", "4000"), ("JAYNET_WEB_PORT", "8071")):
        port = int(os.environ.get(name) or os.environ.get("ORCH_" + name[7:], default))
        with socket.socket() as s:
            s.settimeout(1)
            in_use = s.connect_ex(("127.0.0.1", port)) == 0
        state = "in use (service running or conflict)" if in_use else "free (service down)"
        report("INFO", f"port {port} ({name}): {state}")

    # 5/6. litellm proxy + registered models (WARN — may just be stopped)
    import httpx
    base = paths.LITELLM_BASE
    try:
        r = httpx.get(f"{base}/health/liveliness", timeout=3)
        if r.status_code == 200:
            report("OK", f"litellm proxy live: {base}")
        else:
            report("WARN", f"litellm /health/liveliness → {r.status_code}",
                   "systemctl --user start litellm-proxy")
    except Exception:
        report("WARN", f"litellm proxy down: {base}",
               "systemctl --user start litellm-proxy")
    try:
        headers = {}
        key = os.environ.get("LITELLM_MASTER_KEY")
        if key:
            headers["Authorization"] = f"Bearer {key}"
        r = httpx.get(f"{base}/v1/models", headers=headers, timeout=3)
        models = r.json().get("data", []) if r.status_code == 200 else []
        if models:
            report("OK", f"{len(models)} model(s) registered on the proxy")
        else:
            report("WARN", f"/v1/models → {r.status_code}, 0 models",
                   "check config/litellm.yaml + Admin → Presets")
    except Exception:
        report("WARN", "/v1/models unreachable", "proxy down — see check above")

    # 7. DB writability
    for db in (paths.TRACE_DB, paths.CHATS_DB, paths.USERS_DB):
        ok = os.access(db.parent, os.W_OK) and (not db.exists() or os.access(db, os.W_OK))
        if ok:
            report("OK", f"writable: {db}")
        else:
            report("FAIL", f"not writable: {db}", f"sudo chown -R $USER {db.parent}")

    # 8. GPU tooling
    if shutil.which("rocm-smi") or shutil.which("nvidia-smi"):
        report("OK", "GPU tool on PATH (rocm-smi/nvidia-smi)")
    else:
        report("WARN", "no rocm-smi/nvidia-smi on PATH", "CPU-only inference")

    # 8b. Headless browser (browser.*, web.render, pdf.create) — the same
    # resolution order as tools/browser/session.py: CDP endpoint, then a
    # system Chromium, then Playwright's bundled build.
    import importlib.util
    try:
        import yaml as _yaml
        _bcfg = ((_yaml.safe_load(paths.CONFIG.read_text()) or {})
                 .get("tools", {}).get("browser", {}) or {})
    except Exception:
        _bcfg = {}
    ws = (_bcfg.get("ws_endpoint") or os.environ.get("BROWSER_WS")
          or os.environ.get("PLAYWRIGHT_WS"))
    exe = _bcfg.get("executable_path") or os.environ.get("CHROMIUM_PATH")
    if not exe:
        for name in ("chromium", "chromium-browser",
                     "google-chrome-stable", "google-chrome"):
            exe = shutil.which(name)
            if exe:
                break
    has_pw_lib = importlib.util.find_spec("playwright") is not None
    bundled = Path.home() / ".cache" / "ms-playwright"
    if ws:
        report("OK", f"headless browser: CDP endpoint {ws}")
    elif exe:
        report("OK", f"headless browser: {exe}")
    elif has_pw_lib and bundled.is_dir() and any(bundled.iterdir()):
        report("OK", "headless browser: Playwright bundled build")
    else:
        if shutil.which("pacman"):
            hint = "sudo pacman -S chromium"
        elif shutil.which("apt"):
            hint = ("sudo apt install chromium  (or: "
                    f"{paths.VENV_BIN}/playwright install chromium)")
        else:
            hint = "install a system chromium, or a CDP container (BROWSER_WS)"
        if not has_pw_lib:
            hint = ("playwright lib missing too (uv pip install --python "
                    f"{paths.VENV_BIN}/python playwright) AND {hint}")
        report("WARN", "no headless browser found (browser.*, web.render, "
               "pdf.create will fail)", hint)

    # 9. systemd linger (services die at logout without it)
    user = os.environ.get("USER", "")
    try:
        out = subprocess.run(["loginctl", "show-user", user, "-p", "Linger"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if out == "Linger=yes":
            report("OK", "loginctl linger enabled")
        else:
            report("WARN", f"linger: {out or 'unknown'}",
                   f"sudo loginctl enable-linger {user}")
    except Exception as e:
        report("WARN", f"loginctl failed: {e}")

    # 10. user units installed (jaynet-web; legacy orchestrator-web = migrate)
    units_dir = Path.home() / ".config" / "systemd" / "user"
    for unit, legacy in (("jaynet-web.service", "orchestrator-web.service"),
                         ("litellm-proxy.service", None)):
        if (units_dir / unit).exists():
            report("OK", f"unit installed: {unit}")
        elif legacy and (units_dir / legacy).exists():
            report("WARN", f"legacy unit installed: {legacy}",
                   f"migrate per docs/upgrading.md 'Renamed in 0.9.x' "
                   f"(disable {legacy}, install + enable {unit})")
        else:
            report("WARN", f"unit missing: {unit}",
                   f"install -Dm644 systemd/{unit} {units_dir}/{unit} "
                   "&& systemctl --user daemon-reload")

    # summary
    if fails:
        console.print(f"\n[red]{fails} check(s) FAILED[/red], {warns} warning(s)")
        sys.exit(1)
    if warns:
        console.print(f"\n[green]no failures[/green] — {warns} warning(s)")
    else:
        console.print("\n[green]all checks passed[/green]")


if __name__ == "__main__":
    cli()
