# JayNet reverse proxy example (nginx)
#
# TLS termination + security headers + SSE-friendly proxying in front of the
# web console (default :8071). Adapt hostnames, cert paths and the upstream,
# then drop into /etc/nginx/sites-available/ (or conf.d/).

# --- Add ONCE in the http{} context (e.g. /etc/nginx/conf.d/maps.conf): ---
#
#   # WebSocket upgrade header (only needed if you proxy WS; SSE works without)
#   map $http_upgrade $connection_upgrade {
#       default upgrade;
#       ''      close;
#   }
#   # OPTIONAL rate limit zone for the limit_req line further below
#   limit_req_zone $binary_remote_addr zone=orch:10m rate=10r/s;

# --- Port 80: ACME challenges + redirect to https ---
server {
    server_name ask.example.com;

    location /.well-known {
        alias /data/www/example/.well-known;
    }

    location / {
        return 301 https://ask.example.com$request_uri;
    }
}

# --- Port 443: the console ---
server {
    server_name ask.example.com;
    listen 443 ssl;
    ssl_certificate     /etc/letsencrypt/live/ask.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ask.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;                 # don't leak the nginx version in headers/errors
    client_max_body_size 10M;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # Block hidden/dotfiles at the edge: .env, .env.*, .git, etc. never reach
    # the app. The negative lookahead keeps ACME renewals working.
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        return 404;
    }

    # OPTIONAL, strongest: only let your LAN/VPN reach the console at all.
    # allow 192.168.0.0/24;      # your LAN
    # allow 100.64.0.0/10;       # Tailscale range, if you use it
    # deny  all;

    # OPTIONAL: basic-auth in front of the app's own login (belt & suspenders).
    #    Create the file with:  htpasswd -c /etc/nginx/.htpasswd-orch <user>
    # auth_basic           "restricted";
    # auth_basic_user_file /etc/nginx/.htpasswd-orch;

    # SSE live run feed: never buffer, or tokens/cost arrive in clumps.
    location /api/stream/ {
        proxy_pass http://127.0.0.1:8071;   # the web console; host:port of ORCH install
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location / {
        # limit_req zone=orch burst=20 nodelay;   # uncomment AFTER adding the zone above
        proxy_pass http://127.0.0.1:8071;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
