# JayNet Orchestrator — service environment (TEMPLATE)
# ---------------------------------------------------------------------------
# Where it goes:  ~/.config/orchestrator.env  — the user units read it via
#                 EnvironmentFile=%h/.config/orchestrator.env
# Install:        install -Dm600 example_configs/orchestrator.env.example ~/.config/orchestrator.env
#                 then replace every <...> placeholder with the real value.
#                 Keep chmod 600 — this file holds API keys and tokens.
# Format:         systemd EnvironmentFile: KEY=VALUE only. No quotes, no
#                 ${VAR} expansion, no shell syntax. One var per line.
# Paths:          if the tree is not installed at /srv/orchestrator, change
#                 ALL path lines below to match the real install dir.
# ---------------------------------------------------------------------------

# --- Install + data paths (all four are read by the app) ---------------------
ORCH_HOME=/srv/orchestrator                        # install root (code, config, venv, skills)
ORCH_CONFIG=/srv/orchestrator/config/runtime.yaml  # runtime config the app + start-model.sh load
PYTHONPATH=/srv/orchestrator                       # lets uvicorn import runtime/, web/, tools/
ORCH_DATA=/srv/data                                # runtime state (DBs, uploads, projects, scratch)

# PATH for a systemd --user service (does NOT inherit the login PATH).
# Must reach: the venv (uvicorn/python), git, firejail, ctags, ruff/mypy,
# uv/pip, and rocm-smi (gpu.status).
PATH=/srv/orchestrator/.venv/bin:/usr/local/bin:/usr/bin:/bin:/opt/rocm/bin

# --- Auth / sessions ----------------------------------------------------------
ORCH_SESSION_SECRET=<long-random-string>  # keeps login sessions valid across restarts
ORCH_WEB_TOKEN=<long-random-token>        # static bearer for API / CLI / native clients
# First-boot admin seed — only on a fresh users.db; remove after first login:
# ORCH_ADMIN_USER=admin
# ORCH_ADMIN_PASSWORD=change-me-then-remove

# --- Ports ---------------------------------------------------------------------
# Base services. The systemd units substitute these into their ExecStart lines;
# the app derives the LiteLLM base URL from ORCH_LITELLM_PORT (runtime/paths.py).
# Change here + daemon-reload + restart when 4000/8071 are already taken.
# If you move the proxy, ALSO edit orchestrator.litellm_base in
# config/runtime.yaml — that config value wins over this var.
# (Model-slot ports — brain/specialist/embed/rerank — live in the preset
# catalog, Admin → Presets, not here.)
ORCH_LITELLM_PORT=4000   # LiteLLM proxy
ORCH_WEB_PORT=8071       # web console
# IP(s) uvicorn trusts for X-Forwarded-* headers (--forwarded-allow-ips in the
# web unit): your reverse proxy's IP or LAN gateway. Only matters behind a
# reverse proxy; for same-host-only use 127.0.0.1.
ORCH_FORWARDED_ALLOW_IPS=192.168.124.1

# --- LiteLLM proxy (:4000) ----------------------------------------------------
# Optional: only needed to protect the proxy (multi-user or non-localhost
# exposure). The proxy binds 127.0.0.1, so localhost-only installs may leave
# this unset — the rendered proxy config then omits master_key entirely.
# When set it must equal the proxy's master_key (config/litellm.yaml); also
# used by serve.* when registering runtime model aliases.
LITELLM_MASTER_KEY=<key>

# --- Provider API keys (llm.call cloud models + web.search) -------------------
# Keys live ONLY here. Admin → Presets → Cloud models stores just the env var
# NAME (key_env) per model — never the value.
TAVILY_API_KEY=<key>        # web.search preferred backend
MOONSHOT_API_KEY=<key>      # kimi-k3 (preferred cloud)
GEMINI_API_KEY=<key>        # gemini-pro
DASHSCOPE_API_KEY=<key>     # qwen-plus
OPENROUTER_API_KEY=<key>    # glm-5.2 (routed via OpenRouter)
# ZAI_API_KEY=<key>         # only if glm-5.2 goes direct to Z.ai instead of OpenRouter

# --- Optional overrides (leave commented unless needed) -----------------------
# ORCH_BRAIN_PRESET=/srv/llama/presets/<brain>.conf   # app learns served model + vision; launches nothing
# ORCH_SPECIALIST_PRESET=/srv/orchestrator/presets/<c.conf> # web console shows specialist model details
# ORCH_VERIFIER_MODEL=<litellm-alias>                 # dedicated verify.score model (default: the brain)
# BROWSER_WS=ws://127.0.0.1:9222/                     # containerized Playwright via CDP (else system chromium)
