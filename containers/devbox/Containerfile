# JayNet devbox — the toolchain sandbox for code.run (tools/code/devbox.py).
#
# The firejail sandbox only has whatever is installed on the HOST, so
# "compile this Rust/Go/C#" failed even though the harness can code it.
# This image carries the major coding environments; every chat run that
# needs it gets its own throwaway container with the run's workspace
# bind-mounted (see devbox.py for the lifecycle).
#
# Base: Ubuntu 26.04 LTS (resolute). Chosen over Debian because .NET is a
# hard requirement and Ubuntu is the ONLY distro packaging it first-party:
# dotnet-sdk-10.0 ships in Ubuntu main, dotnet-sdk-8.0 comes from
# Canonical's .NET backports PPA — no Microsoft package feed involved.
#
# Build:  scripts/devbox-build.sh        (podman build -t jaynet-devbox:latest)
# Extend: add packages here and rebuild — version-pinned toolchains
#         (rustup channels, nvm) belong in a derived image.

FROM docker.io/library/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

# Canonical's .NET backports PPA (for dotnet-sdk-8.0; 10.0 is in main).
RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common \
    && add-apt-repository -y ppa:dotnet/backports \
    && apt-get update && apt-get install -y --no-install-recommends \
      bash coreutils findutils grep sed gawk procps \
      ca-certificates curl git make cmake pkg-config \
      python3 python3-pip python3-venv \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu \
      gcc g++ \
      cargo rustc \
      golang \
      nodejs npm \
      openjdk-21-jdk-headless \
      dotnet-sdk-10.0 dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# Dependency caches live on shared named volumes that devbox.py mounts into
# every run container, so downloads survive the per-run container lifetime.
ENV CARGO_HOME=/usr/local/cargo \
    GOPATH=/go \
    npm_config_cache=/root/.npm \
    NUGET_PACKAGES=/root/.nuget/packages
RUN mkdir -p /usr/local/cargo/registry /go/pkg/mod /root/.npm /root/.nuget/packages

WORKDIR /work
CMD ["sleep", "infinity"]
